<table>
    <thead>
        <tr>
            <th>Num</th>
            <th>Nombre</th>
            <th>Descripción</th>
            <th>Precio</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        {{#each productos}}
            <tr>
                <td>{{@index}}</td>
                <td>{{name}}</td>
                <td>{{description}}</td>
                <td>{{price}}</td>
                <td>
                    <button>Status</button>
                    <a href="/update/{{_id}}">Actualizar</a>
                    <form action="/delete/{{_id}}" method="POST" style="display:inline">
                        <button type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        {{/each}}
    </tbody>
</table>