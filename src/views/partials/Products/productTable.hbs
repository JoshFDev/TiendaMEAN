{{#if productos}}
<div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr><th>#</th><th>Nombre</th><th>Descripci&oacute;n</th><th>Precio</th><th>Estado</th><th>Acciones</th></tr>
        </thead>
        <tbody>
            {{#each productos}}
            <tr>
                <td>{{@index}}</td>
                <td>{{name}}</td>
                <td>{{description}}</td>
                <td>${{price}}</td>
                <td><span class="badge bg-{{#if status}}success{{else}}secondary{{/if}}">{{#if status}}Disponible{{else}}No disponible{{/if}}</span></td>
                <td class="action-btns">
                    <form action="/toggle-status/{{_id}}" method="POST" style="display:inline">
                        <button class="btn btn-sm btn-outline-{{#if status}}warning{{else}}success{{/if}}">Status</button>
                    </form>
                    <a href="/update/{{_id}}" class="btn btn-sm btn-outline-primary">Editar</a>
                    <form action="/delete/{{_id}}" method="POST" style="display:inline">
                        <button class="btn btn-sm btn-outline-danger" onclick="return confirm('Eliminar?')">Eliminar</button>
                    </form>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</div>
{{else}}
<div class="text-center py-5">
    <img src="/icons/archivo.png" alt="Sin productos" class="img-fluid" style="max-width:200px; opacity:0.6;">
    <p class="text-muted mt-2">No hay productos</p>
</div>
{{/if}}
